<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Redirecting to ryanpco.com</title>
    <link rel="canonical" href="https://ryanpco.com/">
    <meta name="robots" content="noindex">
    <meta http-equiv="refresh" content="0; url=https://ryanpco.com/">
    <script>
      location.replace('https://ryanpco.com' + location.pathname + location.search + location.hash);
    </script>
  </head>
  <body>
    <p>This site has moved to <a href="https://ryanpco.com/">ryanpco.com</a>.</p>
  </body>
</html>
